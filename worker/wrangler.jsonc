{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synbox-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Browsers reach it as synbox.io/api/* through Netlify; Netlify and Cloud Run call this host directly
  "routes": [{ "pattern": "api.synbox.io", "custom_domain": true }],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "synbox",
      "database_id": "711de2d4-689c-4b5e-92bd-8c5c941c0bd3",
      "migrations_dir": "migrations",
    },
  ],
  // Daily: drops reports the backend's 12-hourly fixer left open for 3 days (src/reports.ts › expireReports),
  // listen rows past their hour (src/songs.ts › pruneListens) and song checks past their 24 hours
  // (src/validations.ts › pruneValidations)
  "triggers": { "crons": ["0 3 * * *"] },
  // Secrets (wrangler secret put): BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET, INTERNAL_SECRET, ADMIN_EMAILS,
  // REPORTS_FIXER_TOKEN (the backend's report fixer holds the same value), and APPWRITE_PROJECT_ID,
  // APPWRITE_DATABASE_ID, APPWRITE_LYRICS_TABLE_ID (the app's VITE_APPWRITE_ values; without them every listen and
  // like is refused: src/library-songs.ts), and GENERATION_INVOKER_KEY (the key of the one account allowed to invoke
  // the generating service; without it generation answers 503: src/generation.ts), and APPWRITE_API_KEY (reads the
  // lyrics table for src/lyrics.ts and src/library-songs.ts), LOOKUP_KEY (the lookup service holds the same value)
  // and TRACE_KEY (signs the translations' invisible mark: src/lyrics.ts, scripts/trace-decode.ts), and CONTACT_TO
  // (where the Contact form is emailed: a verified Email Routing destination of the account; without it messages
  // are only kept for /admin: src/contact.ts)
  // The Contact form's email (src/contact.ts). No restriction attribute, so no address is written here: the binding
  // may mail any verified destination of the account, and CONTACT_TO picks it. The sender must be on one of the
  // account's Email Routing domains
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "CONTACT_FROM": "synbox@edwardhuang.dev",
    "GENERATION_URL": "https://synbox-flask-cloud-run-dtitfmn76a-as.a.run.app",
    "LOOKUP_BASE": "https://synbox-lookup-1045990822048.asia-southeast1.run.app",
    "LYRICS_GUEST_PER_HOUR": "60",
    "LYRICS_NETWORK_PER_HOUR": "300",
    "LYRICS_ACCOUNT_PER_HOUR": "300",
    "BETTER_AUTH_URL": "https://synbox.io",
    "GOOGLE_CLIENT_ID": "1045990822048-sr16qerq3qlv56131g7veuh2nak6vbk8.apps.googleusercontent.com",
    // Songs a signed-in account adds per day, from its own midnight (src/quota.ts); guests add none. The app's copy
    // states it (src/lib/auth.ts › SONGS_A_DAY), so the two change together
    "USER_DAILY_LIMIT": "3",
    "NETWORK_DAILY_LIMIT": "30",
    // Songs a day site-wide: every generation (new, regenerate, retime; accounts and guests) since the later of UTC
    // midnight and the last Resume Generation. The request that would pass it pauses generation for everyone but
    // admins until Resume, and emails CONTACT_TO (src/quota.ts › tripIfFull, src/auto-pause.ts)
    "SITE_DAILY_LIMIT": "100",
    // Song checks (/validate downloads the song) per rolling 24 hours: five times the song limits, ten for a guest
    // (src/validations.ts)
    "VALIDATION_USER_DAILY_LIMIT": "15",
    "VALIDATION_GUEST_DAILY_LIMIT": "10",
    "VALIDATION_NETWORK_DAILY_LIMIT": "150",
    "TRUSTED_ORIGINS": "https://synbox.io,https://www.synbox.io,https://synbox.netlify.app",
  },
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "synbox",
          "database_id": "711de2d4-689c-4b5e-92bd-8c5c941c0bd3",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "BETTER_AUTH_URL": "http://localhost:5173",
        "LOOKUP_BASE": "https://synbox-lookup-1045990822048.asia-southeast1.run.app",
        "LYRICS_GUEST_PER_HOUR": "60",
        "LYRICS_NETWORK_PER_HOUR": "300",
        "LYRICS_ACCOUNT_PER_HOUR": "300",
        "GOOGLE_CLIENT_ID": "1045990822048-sr16qerq3qlv56131g7veuh2nak6vbk8.apps.googleusercontent.com",
        "USER_DAILY_LIMIT": "3",
        "NETWORK_DAILY_LIMIT": "30",
        // As above: the site-wide ceiling that pauses generation automatically
        "SITE_DAILY_LIMIT": "100",
        "VALIDATION_USER_DAILY_LIMIT": "15",
        "VALIDATION_GUEST_DAILY_LIMIT": "10",
        "VALIDATION_NETWORK_DAILY_LIMIT": "150",
        "TRUSTED_ORIGINS": "http://localhost:5173",
      },
    },
  },
}
