{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synbox-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Browsers reach it as synbox.io/api/* through Netlify; Netlify and Cloud Run call this host directly
  "routes": [{ "pattern": "api.synbox.io", "custom_domain": true }],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "synbox",
      "database_id": "711de2d4-689c-4b5e-92bd-8c5c941c0bd3",
      "migrations_dir": "migrations",
    },
  ],
  // Daily: drops reports the backend's 12-hourly fixer left open for 3 days (src/reports.ts › expireReports) and
  // listen rows past their hour (src/songs.ts › pruneListens)
  "triggers": { "crons": ["0 3 * * *"] },
  // Secrets (wrangler secret put): BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET, INTERNAL_SECRET, ADMIN_EMAILS,
  // REPORTS_FIXER_TOKEN (the backend's report fixer holds the same value), and APPWRITE_PROJECT_ID,
  // APPWRITE_DATABASE_ID, APPWRITE_LYRICS_TABLE_ID (the app's VITE_APPWRITE_ values; without them every listen and
  // like is refused: src/library-songs.ts), and GENERATION_INVOKER_KEY (the key of the one account allowed to invoke
  // the generating service; without it generation answers 503: src/generation.ts), and APPWRITE_API_KEY (reads the
  // lyrics table for src/lyrics.ts and src/library-songs.ts), LOOKUP_KEY (the lookup service holds the same value)
  // and TRACE_KEY (signs the translations' invisible mark: src/lyrics.ts, scripts/trace-decode.ts)
  "vars": {
    "GENERATION_URL": "https://synbox-flask-cloud-run-dtitfmn76a-as.a.run.app",
    "LOOKUP_BASE": "https://synbox-lookup-1045990822048.asia-southeast1.run.app",
    "LYRICS_GUEST_PER_HOUR": "60",
    "LYRICS_ACCOUNT_PER_HOUR": "300",
    "BETTER_AUTH_URL": "https://synbox.io",
    "GOOGLE_CLIENT_ID": "1045990822048-sr16qerq3qlv56131g7veuh2nak6vbk8.apps.googleusercontent.com",
    "USER_DAILY_LIMIT": "1",
    "INVITED_DAILY_LIMIT": "10",
    "GUEST_DAILY_LIMIT": "1",
    "GUEST_DAILY_TOTAL": "20",
    "NETWORK_DAILY_LIMIT": "30",
    "TRUSTED_ORIGINS": "https://synbox.io,https://www.synbox.io,https://synbox.netlify.app",
  },
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "synbox",
          "database_id": "711de2d4-689c-4b5e-92bd-8c5c941c0bd3",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "BETTER_AUTH_URL": "http://localhost:5173",
        "LOOKUP_BASE": "https://synbox-lookup-1045990822048.asia-southeast1.run.app",
        "LYRICS_GUEST_PER_HOUR": "60",
        "LYRICS_ACCOUNT_PER_HOUR": "300",
        "GOOGLE_CLIENT_ID": "1045990822048-sr16qerq3qlv56131g7veuh2nak6vbk8.apps.googleusercontent.com",
        "USER_DAILY_LIMIT": "1",
        "INVITED_DAILY_LIMIT": "10",
        "GUEST_DAILY_LIMIT": "1",
        "GUEST_DAILY_TOTAL": "20",
        "NETWORK_DAILY_LIMIT": "30",
        "TRUSTED_ORIGINS": "http://localhost:5173",
      },
    },
  },
}
