{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "types": ["node"],
    "strictNullChecks": true
  },
  "include": [
    "vite.config.ts",
    "netlify/**/*.ts",
    "scripts/**/*.ts",
    "dev/**/*.ts"
  ]
}
