# Copy to .env and fill in. Every VITE_ value is bundled into the browser build.

# Appwrite (Console › Project › Settings / Databases / Storage)
VITE_APPWRITE_URL=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_LYRICS_COLLECTION_ID=
VITE_APPWRITE_SONG_INFO_COLLECTION_ID=

# YouTube Data API v3 key (Google Cloud Console › Credentials). Server-side only: the
# /api/youtube proxy uses it, the browser never sees it. Restrict it to the YouTube Data API.
# On Netlify set it under Site configuration › Environment variables; locally put it here.
YOUTUBE_API_KEY=

# synbox-transcribe-whisper backend
VITE_SYNBOX_BE_URL=http://localhost:8080
# Its lookup service (search, karaoke timing, lyrics versions); leave unset to use VITE_SYNBOX_BE_URL
VITE_SYNBOX_LOOKUP_URL=

# Sentry › synbox-frontend › Settings › Client Keys (DSN). Unset disables Sentry
VITE_SENTRY_DSN=
